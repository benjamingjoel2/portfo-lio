{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/:path*", "destination": "https://cdn.jsdelivr.net/gh/benjamingjoel2/portfolio@d1e0df96cafa18db4a3d6ffc1022235911864540/assets/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
