{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/:path*", "destination": "https://cdn.jsdelivr.net/gh/benjamingjoel2/portfolio@64890cee4bb33b806beac04ecd4e34054b9c3e4a/assets/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
